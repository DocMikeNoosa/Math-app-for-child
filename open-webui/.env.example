# setup.sh copies this to .env and fills it in for your hardware.
# Edit .env afterwards to override anything, then re-run ./setup.sh.

# Hardware tier: auto | small | medium | large | max  (see README.md)
TIER=auto

# Comma-separated Ollama models. Leave empty to use the tier's recommended set.
MODELS=

# Model pre-selected in new chats. Empty = tier default.
DEFAULT_MODEL=

# Speech-to-text model (faster-whisper). Empty = tier default.
# Options: small, medium, Systran/faster-whisper-large-v3 (best accuracy)
WHISPER_MODEL=

# Port the web UI is served on: http://localhost:3000
WEBUI_PORT=3000

# Keeps you logged in across restarts. setup.sh generates a random one.
WEBUI_SECRET_KEY=

# How long a model stays loaded in memory after last use.
OLLAMA_KEEP_ALIVE=30m

# Context window in tokens (larger = longer documents, more memory).
OLLAMA_CONTEXT_LENGTH=16384
