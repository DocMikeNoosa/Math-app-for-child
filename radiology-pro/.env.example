# RadVox Pro — server settings. Copy to .env and fill in. Never commit .env.

# --- AI (choose one) ---
# a) Anthropic API (simplest):
ANTHROPIC_API_KEY=
# b) Claude on Amazon Bedrock in an EU region (data processed in the EU):
# AI_PROVIDER=bedrock
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- first administrator (created on first start if none exists) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- public address and branding ---
PUBLIC_URL=https://radvox.pl
# BRAND_NAME=RadVox Pro
# SUPPORT_EMAIL=kontakt@radvox.pl
# COMPANY_NAME=

# --- e-mail (password reset, reminders) via Resend; without it mail is only logged in the admin panel ---
# RESEND_API_KEY=
# MAIL_FROM=RadVox Pro <no-reply@radvox.pl>

# --- card payments (optional) via Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- server ---
# PORT=3000
# DATA_DIR=./data
# TRUST_PROXY=1          # behind a reverse proxy (Caddy / nginx / Cloudflare): use X-Forwarded-For for rate limiting
