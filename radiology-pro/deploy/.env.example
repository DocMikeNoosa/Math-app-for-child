# ===== RadVox Pro — production settings. Copy to .env (cp .env.example .env) and fill in. NEVER share this file. =====

# --- address
# your domain (DNS A record → this server's IP)
DOMAIN=radiopis.example.pl
# the same, with https:// (used in e-mails)
PUBLIC_URL=https://radiopis.example.pl
# for the HTTPS certificate (expiry warnings)
ACME_EMAIL=admin@example.pl

# --- your administrator account (created on the first start only; change the password after logging in)
ADMIN_EMAIL=admin@example.pl
ADMIN_PASSWORD=change-me-2026-min10chars

# --- AI (choose one)
# A) Anthropic API (key from console.anthropic.com → API keys). Set a monthly spend limit there.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# B) Claude on Amazon Bedrock in the EU (data processed in Frankfurt) — check that the model is available there:
# AI_PROVIDER=bedrock
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- capacity (200 radiologists: see DEPLOY.md, "Capacity")
# AI calls at the same time; the rest wait in a fair queue
AI_MAX_CONCURRENT=60
# longest wait in the queue before "busy, try again"
AI_QUEUE_WAIT_MS=60000
# calls in flight per user
AI_PER_USER=3
# failed logins per 15 min from one IP (a company shares one office IP)
LOGIN_IP_LIMIT=100

# --- e-mail (optional; without it e-mails are only shown in the admin panel → "Dziennik i poczta")
RESEND_API_KEY=
MAIL_FROM=RadVox Pro <no-reply@example.pl>

# --- card payments (optional; companies usually pay by invoice / bank transfer)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- branding
BRAND_NAME=RadVox Pro
COMPANY_NAME=
SUPPORT_EMAIL=

# --- backups (daily, automatic, in ./data/backups)
BACKUP_KEEP_DAYS=14
# Encrypt backups (strongly recommended): a long random passphrase. Store a copy OUTSIDE the server (e.g. in a
# password manager) — without it the backups cannot be read. Generate one: openssl rand -base64 32
BACKUP_KEY=

# --- RODO / terms (version of the terms + privacy notice users must accept; raise when the documents change)
TERMS_VERSION=1.0
