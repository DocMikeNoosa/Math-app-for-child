# HTTPS in front of RadVox Pro. The certificate (Let's Encrypt) is obtained and renewed automatically —
# DOMAIN must already point to this server (DNS A record) and ports 80 + 443 must be open.
{
	email {$ACME_EMAIL}
}

# DOMAIN = the main address (e.g. radvox.ai). EXTRA_DOMAINS (optional, separated by spaces) = other addresses you own
# (e.g. radvox.pl www.radvox.pl www.radvox.ai): they get their own certificate and send every visitor to the main
# address, keeping the page asked for — so there is one login and one set of browser settings, whichever was typed.
{$DOMAIN} {$EXTRA_DOMAINS} {
	@other not host {$DOMAIN}
	redir @other https://{$DOMAIN}{uri} permanent

	encode zstd gzip

	# largest request: syncing a radiologist's learned style (≤ 1.5 MB)
	request_body {
		max_size 2MB
	}

	reverse_proxy app:3000 {
		# during an update / restart the app is away for a few seconds: hold requests up to 30 s instead of failing
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
