# HTTPS in front of Radiopis. The certificate (Let's Encrypt) is obtained and renewed automatically —
# DOMAIN must already point to this server (DNS A record) and ports 80 + 443 must be open.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# largest request: syncing a radiologist's learned style (≤ 1.5 MB)
	request_body {
		max_size 2MB
	}

	reverse_proxy app:3000 {
		# during an update / restart the app is away for a few seconds: hold requests up to 30 s instead of failing
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
